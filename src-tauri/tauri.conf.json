{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroPlayer",
  "version": "1.0.6",
  "identifier": "com.aeroplayer.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "AeroPlayer",
        "width": 1150,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "fullscreen": false,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Muhammad Sheraz",
    "copyright": "Copyright © 2026 Muhammad Sheraz (https://muhammadsheraz.dev)",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERTVERDJENzM4QUMyOEIKUldTTHdvcHpMZDNsdmRnQnpqOE1vWlJreThIR2hYNEMwbWNCS1FvOGRlZGZISWZ6eEIvMC9tSngK",
      "endpoints": [
        "https://raw.githubusercontent.com/muhammadsherazsandila/aeroplayer-desktop/main/updater.json"
      ]
    }
  }
}
